# Copy to /etc/ecs/env on the server (mode 640). Never commit the real file. The installer
# (deploy/bootstrap.sh) creates it for you, named after the instance: /etc/<name>/env.
# Secrets live only here. Mail server settings (SMTP) are kept by PocketBase: set them in the
# admin UI under /_/ > Settings > Mail settings, or with the --smtp-* installer options.

# Where the app listens. Set by the installer; to change any of these re-run setup with the matching
# option (--port, --mode, --listen, --proxy-ip), because Nginx and the firewall have to follow.
#   PW_PORT        the port. Give each copy of the app on one server its own port.
#   PW_LISTEN      127.0.0.1 when Nginx runs on this server; the server's address when an external proxy connects.
#   PW_MODE        local (Nginx and TLS here) or proxy (an external reverse proxy handles TLS)
#   PW_PROXY_IPS   proxy mode: the proxy address or range let through the firewall
PW_PORT=8090
PW_LISTEN=127.0.0.1
PW_MODE=local
PW_PROXY_IPS=

# Public URL of the app (used in e-mail links; the installer also remembers the hostname from it)
APP_URL=https://ecs.example.org

# Seeds the admin PIN on a BLANK database the first time the app is opened. The installer generates
# one, shows it once, and removes this line again once the PIN is in the database. (Ignored once an
# admin PIN exists. Change it afterwards in the app: Events > Admin PIN.)
ECS_ADMIN_PIN=

# Optional: positions from aprs.fi, polled every 5 minutes (https://aprs.fi/page/api)
APRS_FI_API_KEY=

# Optional: sender shown on e-mails (defaults to the PocketBase mail settings)
ECS_MAIL_FROM_NAME="SWCRS ECS"
ECS_MAIL_FROM_ADDRESS=

# Nightly repair of links that point at deleted records (03:30). Set to "off" to switch it off.
#ECS_ORPHAN_CLEANUP=on
