# Environment for the ECS PocketBase service (bootstrap writes /etc/<instance>/<instance>.env from this shape)

# Seeds the admin PIN on a BLANK database the first time the app is opened.
# (Ignored once an admin PIN exists. Change it afterwards in the app: Events > Admin PIN.)
ECS_ADMIN_PIN=123456

# Optional: positions from aprs.fi, polled every 5 minutes (https://aprs.fi/page/api)
APRS_FI_API_KEY=

# Optional: sender shown on e-mails (defaults to the PocketBase mail settings)
ECS_MAIL_FROM_NAME="SWCRS ECS"
ECS_MAIL_FROM_ADDRESS=
